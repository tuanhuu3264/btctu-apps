PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=kpi
DB_PASSWORD=kpi
DB_NAME=kpi
# Bảo mật (ADR-011), giá trị mặc định nếu bỏ trống
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
SESSION_TTL_HOURS=8
PASSWORD_MIN_LENGTH=12
COOKIE_SECURE=false
# Chỉ dùng cho lệnh npm run create-admin (xóa khỏi môi trường sau khi tạo)
# ADMIN_USERNAME=quantri
# ADMIN_PASSWORD=
# Kho tệp đính kèm tương thích S3 (ADR-024). Phát triển: MinIO trong docker (database/docker-compose.yml).
# Đổi sang Cloudflare R2: S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com, S3_REGION=auto, S3_FORCE_PATH_STYLE=false và khóa của R2.
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=kpi-files
S3_ACCESS_KEY=kpiminio
S3_SECRET_KEY=kpiminio-dev-only
S3_FORCE_PATH_STYLE=true
# Tiêu đề bảo mật và giới hạn tần suất (ADR-032), giá trị mặc định nếu bỏ trống
# Đứng sau proxy hoặc bộ cân bằng tải thì đặt số lớp proxy (ví dụ 1) để lấy đúng IP người dùng.
# Cũng nhận danh sách địa chỉ/CIDR (10.0.0.0/8) hoặc loopback. Không đặt true (giả IP được). Bỏ trống nếu không có proxy.
# TRUST_PROXY=1
# RATE_LIMIT_LOGIN_MAX=20            # số lần đăng nhập sai tối đa mỗi IP trong một cửa sổ
# RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
# RATE_LIMIT_GLOBAL_MAX=600          # số request tối đa mỗi IP mỗi cửa sổ
# RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60
# RATE_LIMIT_DISABLED=true           # chỉ dùng khi kiểm thử
