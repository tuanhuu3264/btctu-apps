PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=kpi
DB_PASSWORD=kpi
DB_NAME=kpi
# PostgreSQL đám mây (Supabase...): DB_SSL=true; dùng cổng kết nối trực tiếp hoặc session pooler, không dùng transaction pooler vì có migration
DB_SSL=false
# Bảo mật (ADR-011), giá trị mặc định nếu bỏ trống
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
SESSION_TTL_HOURS=8
# Tự đóng phiên khi không thao tác quá số phút này (ADR-057), tối thiểu 5
SESSION_IDLE_MINUTES=30
PASSWORD_MIN_LENGTH=12
COOKIE_SECURE=false
# Chỉ dùng cho lệnh npm run create-admin (xóa khỏi môi trường sau khi tạo)
# ADMIN_USERNAME=quantri
# ADMIN_PASSWORD=
# Kho tệp đính kèm tương thích S3 (ADR-024). Phát triển: MinIO trong docker (database/docker-compose.yml).
# Đổi sang Cloudflare R2: S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com, S3_REGION=auto, S3_FORCE_PATH_STYLE=false và khóa của R2.
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=kpi-files
S3_ACCESS_KEY=kpiminio
S3_SECRET_KEY=kpiminio-dev-only
S3_FORCE_PATH_STYLE=true
# Xác thực nhiều lớp TOTP (ADR-048)
# MFA_MODE: off (không dùng) | optional (ai đăng ký thì phải nhập mã; mặc định) | required (vai trò quản trị bắt buộc; dùng khi vận hành thật)
# MFA_MODE=optional
# Khóa AES-256 mã hóa khóa TOTP và ký thẻ thử thách, 64 ký tự hex. Sinh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Bắt buộc khi MFA_MODE=required hoặc NODE_ENV=production. Mất khóa thì mọi thiết bị đã đăng ký phải đăng ký lại. Cất trong kho khóa, không đưa vào git.
# MFA_ENCRYPTION_KEY=
# MFA_ISSUER=KPI-OKR Ban To chuc Tinh uy Dak Lak

# Tiêu đề bảo mật và giới hạn tần suất (ADR-032), giá trị mặc định nếu bỏ trống
# Đứng sau proxy hoặc bộ cân bằng tải thì đặt số lớp proxy (ví dụ 1) để lấy đúng IP người dùng.
# Cũng nhận danh sách địa chỉ/CIDR (10.0.0.0/8) hoặc loopback. Không đặt true (giả IP được). Bỏ trống nếu không có proxy.
# TRUST_PROXY=1
# RATE_LIMIT_LOGIN_MAX=20            # số lần đăng nhập sai tối đa mỗi IP trong một cửa sổ
# RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
# RATE_LIMIT_GLOBAL_MAX=600          # số request tối đa mỗi IP mỗi cửa sổ
# RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60
# RATE_LIMIT_DISABLED=true           # chỉ dùng khi kiểm thử

# Sao lưu và phục hồi (ADR-058, deploy/backup/README.md). Chạy: npm run backup | backup:verify | backup:list | backup:restore
# BACKUP_DIR=D:/kpi-backups            # nơi lưu chính, nên khác ổ chứa CSDL
# BACKUP_OFFSITE_DIR=//may-khac/kpi    # nơi lưu thứ hai
# BACKUP_ENCRYPTION_KEY=               # 64 ký tự hex; môi trường thật bắt buộc đặt, cất tách khỏi bản sao lưu
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# BACKUP_KEEP_MONTHLY=12
# BACKUP_S3_BUCKET=kpi-backup           # đẩy bản sao lưu lên MinIO riêng, phải khác S3_BUCKET
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_ENDPOINT=http://may-khac:9000   # trống thì dùng S3_ENDPOINT; môi trường thật nên là máy chủ khác
# BACKUP_PG_CONTAINER=kpi-postgres     # chạy pg_dump trong container; bỏ trống nếu máy có pg_dump
# BACKUP_PG_BIN_DIR=
